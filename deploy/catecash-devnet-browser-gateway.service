[Unit]
Description=Catecash devnet browser wallet gateway container
After=network-online.target catecash-devnet.service
Wants=network-online.target
Requires=catecash-devnet.service

[Service]
Type=simple
ExecStart=/usr/bin/podman run --rm --replace --pull=never --name catecash-devnet-browser-gateway --network host --read-only --cap-drop=all --security-opt=no-new-privileges --user 999:988 --volume /opt/catecash-browser-gateway/gateway.mjs:/app/gateway.mjs:ro --volume /var/lib/catecash/rpc/.cookie:/run/secrets/zebra_rpc_cookie:ro --workdir /app --env CATE_GATEWAY_NETWORK=devnet --env CATE_RPC_URL=http://127.0.0.1:34342/ --env CATE_RPC_COOKIE_FILE=/run/secrets/zebra_rpc_cookie --env CATE_GATEWAY_PORT=34777 docker.io/library/node:24-alpine node gateway.mjs
ExecStop=/usr/bin/podman stop -t 10 catecash-devnet-browser-gateway
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
